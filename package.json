{
  "name": "vrchat-status-bot",
  "version": "1.0.0",
  "description": "VRChat status bot workspace",
  "private": true,
  "scripts": {
    "check": "pnpm -r check",
    "check:write": "pnpm -r check:write",
    "format": "pnpm -r format",
    "lint": "pnpm -r lint",
    "typecheck": "tsc --noEmit",
    "dev:logger": "pnpm --filter @vrchat-status-bot/logger dev",
    "dev:discord": "pnpm --filter @vrchat-status-bot/discord dev"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.8.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
